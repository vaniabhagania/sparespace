# ---- Database (required) ----
# Any Postgres. With the Vercel + Supabase integration this is set for you as POSTGRES_URL.
POSTGRES_URL=postgres://user:password@host:5432/dbname
# Only if your database's TLS certificate is not trusted by Node (some poolers):
# PG_SSL_CA="-----BEGIN CERTIFICATE-----..."   # preferred: pin the provider's CA
# PG_SSL_INSECURE=1                            # last resort: skips certificate verification

# ---- Secrets (required in production; use long random values) ----
# Signs session cookies. Generate: openssl rand -base64 48
SESSION_SECRET=
# Keys phone-number hashing (we never store phone numbers). Generate: openssl rand -base64 48
# Changing this later locks everyone out of their accounts, so set it once and keep it.
PHONE_PEPPER=

# ---- OTP delivery ----
# "twilio" sends real SMS through Twilio Verify. "demo" shows the code on screen (NOT for real users).
OTP_PROVIDER=demo
# Production refuses demo OTPs unless you explicitly allow them (for trying the app yourself):
ALLOW_DEMO_OTP=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---- Admin (optional) ----
# 24+ characters. Enables /admin for handling complaints. Leave empty to disable the admin area.
ADMIN_TOKEN=
